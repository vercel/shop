# Required
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-access-token-here"

# Optional
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key-here"
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here"
# DEBUG_SHOPIFY="1"
# Vercel Flags SDK key for reading dashboard-managed flag values (e.g. cta-color).
# Auto-injected on Vercel when the Flags integration is connected; set locally to
# develop against managed flags. Get it from the Flags page in the Vercel dashboard.
# FLAGS="vercel-flags-sdk-key-here"
# Encrypts the precomputed feature-flag code in the hidden /[flags] URL
# segment. Generate 32 random bytes: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# FLAGS_SECRET="[redacted]"
# NEXT_PUBLIC_BASE_URL="your-domain.com"
# SHOPIFY_API_VERSION="unstable"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_WEBHOOK_SECRET="your-webhook-secret-here"
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/.well-known/ucp"
