# Required
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token-here"

# Optional
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key-here"
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here"
# DEBUG_SHOPIFY="1" # Log structured Shopify API operation timings.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="123456789"
# SHOPIFY_API_VERSION="unstable"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET="your-customer-account-client-secret-here" # Required when auth.isEnabled is true.
# SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret-here"
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/agent/ucp-profile.json" # Optional override for the public Eve agent profile.

# Required when agent.isEnabled is true. Keep the secret and Redis credentials server-only.
# AGENT_SESSION_SECRET="your-agent-session-secret-at-least-32-characters-here" # Generate with openssl rand -base64 32.
# AGENT_REDIS_URL="https://your-redis-instance.upstash.io" # Upstash Redis REST URL for private session ownership and replay protection.
# AGENT_REDIS_TOKEN="your-redis-rest-token-here" # Upstash Redis REST token for the same database.
# AGENT_STOREFRONT_URL="http://localhost:3000" # Exact browser-facing origin; set the deployment's HTTPS URL in production and previews.
# VERCEL_AUTOMATION_BYPASS_SECRET="your-vercel-bypass-secret-here" # Only when deployment protection blocks Eve's same-project commerce requests.
# EVE_DEV="1" # Set by eve dev; selects Shopify's public example profile when local URLs are unreachable.
