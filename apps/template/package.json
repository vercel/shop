{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm codegen && next build",
    "build:agent": "eve build",
    "codegen": "pnpm codegen:storefront && pnpm codegen:customer",
    "codegen:customer": "graphql-codegen --project customer",
    "codegen:storefront": "graphql-codegen --project storefront",
    "codegen:watch": "graphql-codegen --project storefront --watch",
    "dev": "pnpm codegen || true && next dev",
    "dev:portless": "pnpm codegen || true && portless shop next dev",
    "format": "oxfmt",
    "lint": "oxlint . && oxfmt --check",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && pnpm codegen"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@graphql-codegen/cli": "7.4.1",
    "@shopify/api-codegen-preset": "3.0.0",
    "@shopify/hydrogen": "2026.10.0-preview.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.97",
    "babel-plugin-react-compiler": "1.0.0",
    "botid": "1.5.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "eve": "0.54.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "streamdown": "2.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "zod": "4.6.2"
  },
  "engines": {
    "node": "24"
  }
}
