{
  "dependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "turbo": "2.10.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "24.x"
    }
  },
  "name": "@vercel/shop",
  "packageManager": "pnpm@12.3.4",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "plugin:install:local": "npx plugins add ./packages/plugin --scope project --yes",
    "release": "changeset publish",
    "start": "turbo run start",
    "test": "turbo run test",
    "version": "changeset version"
  }
}
